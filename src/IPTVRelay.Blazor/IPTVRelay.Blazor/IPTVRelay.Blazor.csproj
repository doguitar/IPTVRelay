<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net8.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<GenerateAssemblyConfigurationAttribute>false</GenerateAssemblyConfigurationAttribute>
		<GenerateAssemblyInformationalVersionAttribute>false</GenerateAssemblyInformationalVersionAttribute>
		<UserSecretsId>70bce7e0-4493-4038-bc5f-e801198286c3</UserSecretsId>
		<DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
		<DockerfileContext>..\..</DockerfileContext>
	</PropertyGroup>

	<Target Name="Config" BeforeTargets="PreBuildEvent">
		<Exec Command="if not exist $(ProjectDir)appsettings.$(Configuration).json echo {}&gt;$(ProjectDir)appsettings.$(Configuration).json" />
	</Target>

	<ItemGroup>
		<Content Remove="appsettings.json" />
		<Content Remove="appsettings.$(Configuration).json" />
		<Content Include="appsettings.json">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</Content>
		<Content Include="appsettings.$(Configuration).json">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
			<DependentUpon>appsettings.json</DependentUpon>
		</Content>
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\IPTVRelay.Database.Psql\IPTVRelay.Database.Psql.csproj" />
		<ProjectReference Include="..\..\IPTVRelay.Database.Sqlite\IPTVRelay.Database.Sqlite.csproj" />
		<ProjectReference Include="..\..\IPTVRelay.Database\IPTVRelay.Database.csproj" />
		<ProjectReference Include="..\..\IPTVRelay.Library.Components\IPTVRelay.Library.Components.csproj" />
		<ProjectReference Include="..\..\IPTVRelay.Library\IPTVRelay.Library.csproj" />
		<PackageReference Include="Blazor.Bootstrap" Version="1.11.1" />
		<PackageReference Include="Blazored.Video" Version="1.0.1" />
		<PackageReference Include="CommandLineParser" Version="2.9.1" />
		<PackageReference Include="Enums.NET" Version="4.0.2" />
		<PackageReference Include="Hangfire" Version="1.8.10" />
		<PackageReference Include="Hangfire.AspNetCore" Version="1.8.10" />
		<PackageReference Include="Hangfire.Storage.SQLite" Version="0.4.1" />
		<PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="8.0.1" />
		<PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.19.6" />
		<PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
	</ItemGroup>

</Project>
