@inherits BaseComponent


@code {
    private FilterVM Current = new() { Invert = true, FilterType = Database.Enums.FilterType.Contains };

    [Parameter] public ObservableCollection<M3UItem> Items { get; set; } = [];
    [Parameter] public List<FilterItemVM<M3UItem>> FilteredItems { get; set; } = [];
    [Parameter] public ObservableCollection<FilterVM> Filters { get; set; } = [];

    [Parameter] public EventCallback<FilterVM> OnTest { get; set; }
    [Parameter] public EventCallback<FilterVM> OnApply { get; set; }
    [Parameter] public EventCallback<FilterVM> OnDelete { get; set; }

    [Parameter] public EventCallback<List<FilterItemVM<M3UItem>>> FilteredItemsChanged { get; set; }
    [Parameter] public EventCallback<ObservableCollection<FilterVM>> FiltersChanged { get; set; }
    [Parameter] public EventCallback<ObservableCollection<M3UItem>> ItemsChanged { get; set; }

    [Parameter] public RenderFragment<FilterItemVM<M3UItem>>? ChildContent { get; set; }

    private Dictionary<Database.Enums.FilterType, string> FilterTypes { get; } =
        Enum.GetValues<Database.Enums.FilterType>().ToDictionary(e => e, e => e.AsString(EnumFormat.Description) ?? e.ToString());

}
<Loader IsLoading=IsLoading>
    <Table TItem="FilterVM" Items="@Filters" Class="filterTable">
        <HeaderColumns>
            <th class="filterType">Type</th>
            <th class="filterContent">Value</th>
            <th class="filterInvert">Invert</th>
            <th class="filterButton"></th>
            <th></th>
        </HeaderColumns>
        <PreRows>
            <tr>
                <td colspan="5">
                    <div class="input-group">
                        <div class="input-group-prepend">
                            <DropDownList TItem=Database.Enums.FilterType @bind-SelectedItem=Current.FilterType Values=FilterTypes OutlineColor="ButtonOutlineColor.Light" Color="ButtonColor.Secondary" />
                        </div>
                        <InputText class="form-control" @bind-Value="Current.FilterContent"></InputText>
                        <div class="input-group-append">
                            <div class="input-group-text">
                                <input type="checkbox" aria-label="" checked="@(Current.Invert)" @oninput="()=>Current.Invert = !Current.Invert">
                            </div>
                            <EyeButton class="input-group-text" Disabled="@(Current.FilterType == Database.Enums.FilterType.None)" @onclick="Test"></EyeButton>
                            <AddButton class="input-group-text" Disabled="@(Current.FilterType == Database.Enums.FilterType.None)" @onclick="Apply"></AddButton>
                        </div>
                    </div>
                </td>
            </tr>
        </PreRows>
        <RowColumns>
            <td colspan="5">
                <div class="input-group">
                    <div class="input-group-prepend">
                        <DropDownList TItem=Database.Enums.FilterType SelectedItem=context.FilterType Values=FilterTypes OutlineColor="ButtonOutlineColor.Dark" Color="ButtonColor.Secondary" Disabled=true />
                    </div>
                    <InputText class="form-control" disabled @bind-Value="context.FilterContent"></InputText>
                    <div class="input-group-append">
                        <div class="input-group-text">
                            <input type="checkbox" checked="@(context.Invert)" aria-label="">
                        </div>
                        <DeleteButton @onclick="() => Delete(context)"></DeleteButton>
                    </div>
                </div>
            </td>
        </RowColumns>
    </Table>

    @if (ChildContent != null && FilteredItems != null && FilteredItems.Count > 0)
    {
        foreach (var item in FilteredItems)
        {
            @ChildContent(item)
        }
    }
</Loader>

@code {
    protected override async Task OnParametersSetAsync()
    {
        Filters.CollectionChanged += async (s, e) => await FilterItemsAsync();
        Items.CollectionChanged += async (s, e) => await FilterItemsAsync();
        await base.OnParametersSetAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await FilterItemsAsync();
        }
        await base.OnAfterRenderAsync(firstRender);
    }

    private async Task FilterItemsAsync()
    {
        await SetLoading();
        FilteredItems = (await Library.FilterHelper.DoFilter(Items, Filters)).Select(i => new FilterItemVM<M3UItem> { Item = i }).ToList();
        await FilteredItemsChanged.InvokeAsync(FilteredItems);

        await SetLoaded();
    }

    private async Task Test()
    {
        await TestFilter(Current);
        await OnTest.InvokeAsync(Current);
    }
    private async Task Apply()
    {
        await OnApply.InvokeAsync(Current);
        await ApplyFilter(Current);
        Current = new() { FilterType = Current.FilterType, Invert = true };
    }
    private async Task Delete(FilterVM filter)
    {
        await SetLoading();
        Filters.Remove(filter);
        await FiltersChanged.InvokeAsync(Filters);
        await OnDelete.InvokeAsync(filter);
        await SetLoaded();
    }

    protected void FilterTypeChanged(Database.Enums.FilterType filterType)
    {
        Current.FilterType = filterType;
    }

    public void SetFilterText(string text)
    {
        Current.FilterContent = text;
    }
    public void SetFilterType(Database.Enums.FilterType type)
    {
        Current.FilterType = type;
    }
    public void SetInverted(bool inverted)
    {
        Current.Invert = inverted;
    }

    public async Task TestFilter(FilterVM filter)
    {
        await SetLoading();

        var filtered = (await Library.FilterHelper.DoFilter(FilteredItems.Select(f=>f.Item), filter));
        FilteredItems = FilteredItems.OrderBy(fi =>
        {
            var index = filtered.IndexOf(fi.Item);
            fi.Filtered = index > -1;
            return index;
        }).ToList();
        FilteredItems = FilteredItems.OrderBy(fi => fi.Filtered).ToList();
        await SetLoaded();
    }
    public async Task ApplyFilter(FilterVM filter)
    {
        await SetLoading();
        Filters.Add(filter);
        await FiltersChanged.InvokeAsync(Filters);
        await SetLoaded();
    }
}
