@inherits BaseModal<GuideModalVM>

@code {
    public XMLTV? Guide { get; set; }
}

<Loader IsLoading=@(IsLoading || Model.IsNull())>
    <div class="row">
        <div class="col-md-12">
            <div class="input-group mb-3">
                <InputText class="form-control" placeholder="Name" aria-label="Name" aria-describedby="basic-addon2" @bind-Value=Model.Name></InputText>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-md-12">
            <div class="input-group mb-3">
                <InputText class="form-control" aria-label="XMLTV Location" aria-describedby="basic-addon2"
                           placeholder="XMLTV Location" @bind-Value=Model.Uri></InputText>
                <div class="input-group-append">
                    <DownloadButton OnClick="GetUri"></DownloadButton>
                </div><div class="input-group-append">
                    <span class="input-group-text" id="basic-addon2">@Model.Count</span>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-12">
            <div class="float-end">
                <SaveButton OnClick="Save" Disabled="CanSave && Model.Uri == Guide?.Uri"></SaveButton>
                <CloseButton OnClick="Cancel"></CloseButton>
            </div>
        </div>
    </div>
</Loader>

@code {

    protected async Task GetUri()
    {
        await SetLoading();
        if (Uri.TryCreate(Model?.Uri, UriKind.Absolute, out var uri))
        {
            try
            {
                DB.ChangeTracker.Clear();
                Guide = ModelId > 0 ? await DB.XMLTV
                    .Include(g => g.Items).ThenInclude(i => i.GuideData)
                    .Where(g => g.Id == ModelId)
                    .FirstAsync()
                    : new XMLTV();

                await XMLTVParser.Parse(uri, Guide);
                Guide.Uri = Model.Uri = uri.AbsoluteUri;
                Model.Count = Guide.Items.Count;
                CanSave = Model.Count > 0;
            }
            catch (Exception e)
            {
                //await SetError(e.Message);
            }
        }
        await SetLoaded();
    }

    public override async Task Save()
    {
        await SetLoading();
        if (Guide.IsNotNull())
        {
            Guide.Name = Model.Name;
            if (Guide?.Id == 0)
            {
                await DB.XMLTV.AddAsync(Guide);
            }

            await DB.SaveChangesAsync();
            Model.Id = ModelId = Guide!.Id;

            DB.ChangeTracker.Clear();
            Guide = null;
            GC.Collect();
        }
        await SetLoaded();
        await OnSave.InvokeAsync(new ModalEventArgs<GuideModalVM>(Model));
    }
    public override async Task Cancel()
    {
        await OnCancel.InvokeAsync();
    }
    public override async Task Load()
    {
        await SetLoading();
        if (ModelId > 0)
        {
            Model = await DB.XMLTV.AsNoTracking()
                .Include(g => g.Items)
                .Where(g => g.Id == ModelId)
                .Select(g => new GuideModalVM
                    {
                        Count = g.Items == null ? 0 : g.Items.Count,
                        Id = g.Id,
                        Name = g.Name ?? string.Empty,
                        Uri = g.Uri ?? string.Empty
                    })
                .FirstAsync();
        }
        else
        {
            Model = new GuideModalVM();
        }
        await SetLoaded();
    }
}